---
import CardNewsCard from '../../components/CardNewsCard.astro';
import Base from '../../layouts/Base.astro';
import { getCardNews } from '../../lib/content';
import { formatDate, url } from '../../lib/site';

const sets = await getCardNews();
---

<Base title="게임 트렌드 카드뉴스" description="매일 아침 국내외 게임 업계 소식을 카드로 정리해요">
  <header class="page-head">
    <h1>게임 트렌드 카드뉴스</h1>
    <p class="lead">한국·일본·영미권 게임 매체의 소식을 매일 아침 카드로 정리해요. 카드마다 원문 링크가 있어요.</p>
  </header>

  {
    sets.length === 0 ? (
      <p class="empty">아직 카드뉴스가 없어요. 매일 아침 자동으로 만들어져요.</p>
    ) : (
      <div class="cn-grid">
        {sets.map((set) => (
          <a class="cn-item" href={url(`/cardnews/${set.id}/`)}>
            <CardNewsCard variant="cover" accent={set.data.accent} title={set.data.title} summary={set.data.summary} date={set.data.date} />
            <p class="meta">
              {formatDate(set.data.date)} · 카드 {set.data.cards.length + 1}장{set.data.mode === 'headlines' && ' · 헤드라인'}
            </p>
          </a>
        ))}
      </div>
    )
  }
</Base>

<style>
  .cn-grid {
    display: grid;
    gap: 24px 20px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
  }
  .cn-item {
    color: inherit;
  }
  .cn-item:hover {
    text-decoration: none;
  }
  .cn-item :global(.cn-card) {
    transition: transform 0.2s;
  }
  .cn-item:hover :global(.cn-card) {
    transform: translateY(-3px);
  }
  .cn-item .meta {
    margin: 10px 2px 0;
  }
</style>
