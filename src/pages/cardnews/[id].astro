---
import type { CollectionEntry } from 'astro:content';
import CardNewsViewer from '../../components/CardNewsViewer.astro';
import Base from '../../layouts/Base.astro';
import { getCardNews } from '../../lib/content';
import { formatDate, url } from '../../lib/site';

export async function getStaticPaths() {
  const sets = await getCardNews();
  return sets.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: sets[i - 1], older: sets[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'cardnews'>;
  newer?: CollectionEntry<'cardnews'>;
  older?: CollectionEntry<'cardnews'>;
}

const { entry, newer, older } = Astro.props;
const { title, summary, date, mode, tags, cards } = entry.data;
const MODE_LABELS = { ai: 'AI 요약', headlines: '헤드라인 모음', manual: '직접 작성' };
const seen = new Set<string>();
const sources = cards.flatMap((card) => card.sources).filter((source) => !seen.has(source.url) && seen.add(source.url));
---

<Base title={title} description={summary}>
  <a class="back" href={url('/cardnews/')}>← 카드뉴스</a>
  <CardNewsViewer entry={entry} />

  <section class="details">
    <p class="meta">{formatDate(date)} · {MODE_LABELS[mode]}</p>
    {
      tags.length > 0 && (
        <ul class="chips">
          {tags.map((tag) => (
            <li class="chip">#{tag}</li>
          ))}
        </ul>
      )
    }
    {
      sources.length > 0 && (
        <>
          <h2>출처</h2>
          <ol class="sources">
            {sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener">
                  {source.title ?? source.url}
                </a>
                <span class="meta"> · {source.label}</span>
              </li>
            ))}
          </ol>
        </>
      )
    }
    <nav class="pager" aria-label="다른 날 카드뉴스">
      {older ? <a href={url(`/cardnews/${older.id}/`)}>← {formatDate(older.data.date)}</a> : <span />}
      {newer && <a href={url(`/cardnews/${newer.id}/`)}>{formatDate(newer.data.date)} →</a>}
    </nav>
  </section>
</Base>

<style>
  .details {
    max-width: 540px;
    margin: 32px auto 0;
  }
  .details h2 {
    margin: 28px 0 8px;
    font-size: 16px;
  }
  .sources {
    margin: 0;
    padding-left: 1.3em;
    font-size: 14px;
  }
  .sources li + li {
    margin-top: 6px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 15px;
    font-weight: 600;
  }
</style>
