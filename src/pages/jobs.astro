---
// 채용 추천 — src/data/jobs.json (scripts/jobs 가 매일 갱신). 검색 엔진 색인에서는 뺀다.
import Base from '../layouts/Base.astro';
import { jobsData, PICK_LABELS, SOURCE_LABELS, type Job } from '../lib/jobs';
import { formatDate, formatDateTime } from '../lib/site';

const { jobs, recommendations, updatedAt } = jobsData;
const byId = new Map(jobs.map((job) => [job.id, job]));
const picks = (recommendations?.picks ?? []).flatMap((pick) => {
  const job = byId.get(pick.jobId);
  return job ? [{ ...pick, job }] : [];
});
const companies = [...new Set(jobs.map((job) => job.company))].sort((a, b) => a.localeCompare(b));
const searchText = (job: Job) => [job.title, job.company, job.location, job.department].join(' ').toLowerCase();
---

<Base title="채용 추천" description="일본·해외 게임 회사 채용 공고와 오늘의 추천" noindex>
  <header class="page-head">
    <h1>채용 추천</h1>
    <p class="lead">일본·해외 게임 회사 공고를 매일 아침 모으고, 기술 일기로 만든 포트폴리오에 맞춰 세 곳을 골라요.</p>
    <p class="meta">
      {updatedAt ? `마지막 업데이트 ${formatDateTime(updatedAt)}` : '아직 수집 전'} · 공고 {jobs.length}건 · 회사 {companies.length}곳
    </p>
  </header>

  <section>
    <h2 class="section-title">오늘의 추천</h2>
    {
      picks.length > 0 ? (
        <>
          <div class="picks">
            {picks.map((pick) => (
              <article class={`card pick pick-${pick.type}`}>
                <span class="badge">{PICK_LABELS[pick.type]}</span>
                <p class="pick-company">
                  {pick.job.company}
                  {pick.job.location && ` · ${pick.job.location}`}
                </p>
                <h3>
                  <a href={pick.job.url} target="_blank" rel="noopener">
                    {pick.job.title}
                  </a>
                </h3>
                <p>{pick.reason}</p>
                {pick.gaps.length > 0 && (
                  <div class="pick-gaps">
                    <strong>보완할 점</strong>
                    <ul>
                      {pick.gaps.map((gap) => (
                        <li>{gap}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {pick.tip && (
                  <p class="pick-tip">
                    <strong>지원 팁</strong> {pick.tip}
                  </p>
                )}
              </article>
            ))}
          </div>
          {recommendations && (
            <p class="meta">
              {formatDateTime(recommendations.generatedAt)} · {recommendations.model} 가 골랐어요.
            </p>
          )}
        </>
      ) : (
        <p class="empty">아직 추천이 없어요. AI 추천은 매일 아침 공고를 모은 뒤에 만들어져요.</p>
      )
    }
  </section>

  <section data-jobs>
    <h2 class="section-title">
      전체 공고 <span class="meta"><span data-count>{jobs.length}</span>건</span>
    </h2>
    {
      jobs.length === 0 ? (
        <p class="empty">아직 수집된 공고가 없어요.</p>
      ) : (
        <>
          <div class="filters">
            <input type="search" placeholder="직무 · 회사 · 지역 검색" aria-label="공고 검색" data-search />
            <select aria-label="회사" data-company>
              <option value="">모든 회사</option>
              {companies.map((company) => (
                <option value={company}>{company}</option>
              ))}
            </select>
          </div>
          <ul class="job-list">
            {jobs.map((job) => (
              <li class="job" data-job data-search={searchText(job)} data-company-name={job.company} data-first-seen={job.firstSeenAt}>
                <div class="job-main">
                  <p class="job-company">
                    {job.company}
                    <span class="badge good" data-new hidden>
                      NEW
                    </span>
                  </p>
                  <a class="job-title" href={job.url} target="_blank" rel="noopener">
                    {job.title}
                  </a>
                  <p class="meta">{[job.location, job.department].filter(Boolean).join(' · ')}</p>
                </div>
                <div class="job-side meta">
                  <span>{SOURCE_LABELS[job.source] ?? job.source}</span>
                  {job.deadline ? <span>~{formatDate(job.deadline)}</span> : job.postedAt && <span>{formatDate(job.postedAt)}</span>}
                </div>
              </li>
            ))}
          </ul>
          <p class="empty" data-empty hidden>
            조건에 맞는 공고가 없어요.
          </p>
        </>
      )
    }
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-jobs]');
  const input = root?.querySelector<HTMLInputElement>('[data-search]');
  const select = root?.querySelector<HTMLSelectElement>('[data-company]');
  if (root && input && select) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-job]'));
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;

    // 처음 수집된 지 3일 안 된 공고에 NEW 표시 (빌드 시점이 아니라 지금 기준)
    for (const item of items) {
      if (Date.now() - Date.parse(item.dataset.firstSeen ?? '') < 3 * 86_400_000) {
        item.querySelector('[data-new]')?.removeAttribute('hidden');
      }
    }

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const visible = (!query || (item.dataset.search ?? '').includes(query)) && (!select.value || item.dataset.companyName === select.value);
        item.hidden = !visible;
        if (visible) shown += 1;
      }
      count.textContent = String(shown);
      empty.hidden = shown > 0;
    };
    input.addEventListener('input', apply);
    select.addEventListener('change', apply);
  }
</script>

<style>
  .picks {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    margin-bottom: 10px;
  }
  /* 도장 색: 적정 = 올리브, 상향 = 러스트, 관심 = 테라코타 */
  .pick-match .badge {
    color: var(--good);
  }
  .pick-reach .badge {
    color: var(--hot);
  }
  .pick-company {
    margin: 12px 0 2px;
    color: var(--muted);
    font-size: 14px;
  }
  .pick h3 {
    margin: 0 0 10px;
    font-size: 17px;
  }
  .pick h3 a {
    color: var(--text);
  }
  .pick p {
    margin: 0 0 12px;
    font-size: 15px;
  }
  .pick strong {
    color: var(--accent-text);
    font-size: 14px;
  }
  .pick-gaps ul {
    margin: 4px 0 12px;
    padding-left: 1.1em;
    color: var(--muted);
    font-size: 14px;
  }
  .pick-tip {
    color: var(--muted);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 8px;
  }
  .filters input,
  .filters select {
    min-width: 0;
    padding: 9px 16px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 15px;
  }
  .filters input {
    flex: 1 1 220px;
  }
  .filters select {
    flex: 0 1 240px;
  }
  .job-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .job {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--border);
  }
  .job-main {
    min-width: 0;
  }
  .job-company {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--muted);
    font-size: 14.5px;
  }
  .job-title {
    color: var(--ink);
    font-size: 17px;
  }
  .job .meta {
    margin: 2px 0 0;
  }
  .job-side {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    align-items: flex-end;
    text-align: right;
  }
  @media (max-width: 560px) {
    .job {
      flex-direction: column;
      gap: 6px;
    }
    .job-side {
      flex-direction: row;
      gap: 10px;
    }
  }
</style>
