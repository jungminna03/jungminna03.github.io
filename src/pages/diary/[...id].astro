---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getDiary } from '../../lib/content';
import { formatDate, url } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getDiary();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'diary'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, tags, project, skills, highlight, description, draft } = entry.data;
---

<Base title={title} description={description ?? highlight}>
  <article>
    <a class="back" href={url('/diary/')}>← 기술 일기</a>
    <header class="post-head">
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {project && <span> · {project}</span>}
        {draft && <span class="badge warn">초안</span>}
      </p>
      <h1>{title}</h1>
      {
        tags.length > 0 && (
          <ul class="chips">
            {tags.map((tag) => (
              <li class="chip">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    {
      highlight && (
        <aside class="highlight">
          <strong>핵심 성과</strong>
          <p>{highlight}</p>
        </aside>
      )
    }
    <div class="prose">
      <Content />
    </div>
    {
      skills.length > 0 && (
        <footer class="post-skills">
          <span class="meta">사용 기술</span>
          <ul class="chips">
            {skills.map((skill) => (
              <li class="chip">{skill}</li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>
</Base>

<style>
  article {
    max-width: 720px;
  }
  .post-head {
    margin-bottom: 28px;
  }
  .post-head h1 {
    margin: 4px 0 12px;
    font-size: clamp(28px, 4.5vw, 38px);
  }
  .post-head .badge {
    margin-left: 6px;
  }
  .highlight {
    margin: 0 0 32px;
    padding: 14px 18px;
    border-radius: 12px;
    background: var(--accent-soft);
  }
  .highlight strong {
    color: var(--accent-text);
    font-size: 13px;
  }
  .highlight p {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .post-skills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
</style>
