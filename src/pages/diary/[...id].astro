---
// 일기 한 편 — 책상 위에 종이 한 장
import { render, type CollectionEntry } from 'astro:content';
import Sprite from '../../components/Sprite.astro';
import Desk from '../../layouts/Desk.astro';
import { getDiary } from '../../lib/content';
import { formatDate, url } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getDiary();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'diary'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, tags, project, skills, highlight, description, draft } = entry.data;
---

<Desk title={title} description={description ?? highlight}>
  <div class="single">
    <a class="px-btn back-btn" href={url('/diary/')}><Sprite name="arrowL" scale={2} /> 책상으로</a>
    <article class="paper paper-diary paper-single">
      <span class="clip" aria-hidden="true"><Sprite name="clip" scale={4} /></span>
      <header class="post-head">
        <p class="meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {project && <span> · {project}</span>}
          {draft && <span class="stamp maybe">초안</span>}
        </p>
        <h1>{title}</h1>
        {
          tags.length > 0 && (
            <ul class="chips">
              {tags.map((tag) => (
                <li class="chip">#{tag}</li>
              ))}
            </ul>
          )
        }
      </header>
      {
        highlight && (
          <aside class="highlight">
            <strong>핵심 성과</strong>
            <p>{highlight}</p>
          </aside>
        )
      }
      <div class="prose">
        <Content />
      </div>
      {
        skills.length > 0 && (
          <footer class="post-skills">
            <span class="meta">사용 기술</span>
            <ul class="chips">
              {skills.map((skill) => (
                <li class="chip chip-strong">{skill}</li>
              ))}
            </ul>
          </footer>
        )
      }
    </article>
  </div>
</Desk>
