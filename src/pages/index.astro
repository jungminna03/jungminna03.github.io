---
import CardNewsCard from '../components/CardNewsCard.astro';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import profile from '../../config/profile.mjs';
import { getCardNews, getDiary, toPortfolioEntry } from '../lib/content';
import { jobsData } from '../lib/jobs';
import { buildPortfolio } from '../lib/portfolio.mjs';
import { formatDate, url } from '../lib/site';

const diary = await getDiary();
const latestNews = (await getCardNews())[0];
const portfolio = buildPortfolio(diary.map(toPortfolioEntry), profile.skills);
const picks = jobsData.recommendations?.picks ?? [];

const features = [
  {
    href: '/diary/',
    icon: 'quill',
    title: '기술 일기',
    text: '배운 것과 해결한 문제를 기록해요.',
    stat: diary.length ? `기록 ${diary.length}개 · 최근 ${formatDate(diary[0].data.date)}` : '첫 기록을 기다리는 중',
  },
  {
    href: '/portfolio/',
    icon: 'folder',
    title: '포트폴리오',
    text: '일기가 프로젝트·성과·기술로 자동 정리돼요.',
    stat: `프로젝트 ${portfolio.projects.length}개 · 기술 ${portfolio.skills.length}개`,
  },
  {
    href: '/jobs/',
    icon: 'compass',
    title: '채용 추천',
    text: '일본·해외 게임 회사 공고 중 세 곳을 골라요.',
    stat: `공고 ${jobsData.jobs.length}건 · 추천 ${picks.length}곳`,
  },
  {
    href: '/cardnews/',
    icon: 'cards',
    title: '게임 트렌드',
    text: '매일 아침 게임 업계 소식을 카드로 엮어요.',
    stat: latestNews ? `최신 ${formatDate(latestNews.data.date)}` : '첫 카드뉴스를 기다리는 중',
  },
] as const;
---

<Base>
  <section class="hero">
    <p class="eyebrow">✦ Game Dev Workshop ✦</p>
    <h1 class="hero-title">{profile.siteTitle}</h1>
    <p class="hero-headline">{profile.headline}</p>
    <p class="lead">{profile.intro}</p>
    <div class="hero-actions">
      <a class="btn" href={url('/portfolio/')}>포트폴리오 보기</a>
      {profile.links.GitHub && <a class="btn ghost" href={profile.links.GitHub}>GitHub</a>}
    </div>
  </section>

  <section class="grid features" aria-label="메뉴">
    {
      features.map((feature) => (
        <a class="card feature" href={url(feature.href)}>
          <span class="feature-icon">
            <Icon name={feature.icon} />
          </span>
          <h2>{feature.title}</h2>
          <p>{feature.text}</p>
          <span class="chip">{feature.stat}</span>
        </a>
      ))
    }
  </section>

  <div class="split">
    <section>
      <h2 class="section-title">최근 기술 일기 <a href={url('/diary/')}>전체 보기 →</a></h2>
      {
        diary.length ? (
          <ul class="recent">
            {diary.slice(0, 5).map((entry) => (
              <li>
                <a href={url(`/diary/${entry.id}/`)}>{entry.data.title}</a>
                <span class="leader" aria-hidden="true" />
                <span class="meta">{formatDate(entry.data.date)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">
            <code>src/content/diary</code> 에 첫 기록을 남겨 보세요.
          </p>
        )
      }
    </section>
    <section>
      <h2 class="section-title">오늘의 카드뉴스 <a href={url('/cardnews/')}>전체 보기 →</a></h2>
      {
        latestNews ? (
          <a class="news" href={url(`/cardnews/${latestNews.id}/`)} aria-label={latestNews.data.title}>
            <CardNewsCard
              variant="cover"
              accent={latestNews.data.accent}
              title={latestNews.data.title}
              summary={latestNews.data.summary}
              date={latestNews.data.date}
            />
          </a>
        ) : (
          <p class="empty">매일 아침 자동으로 만들어져요.</p>
        )
      }
    </section>
  </div>
</Base>

<style>
  .hero {
    padding: 28px 0 48px;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 4px;
    color: var(--accent-text);
    font-size: 14px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  .hero-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--script);
    font-size: clamp(56px, 11vw, 96px);
    line-height: 1.05;
    letter-spacing: 0;
  }
  .hero-headline {
    margin: 10px 0 14px;
    color: var(--accent-text);
    font-size: 19px;
  }
  .hero .lead {
    max-width: 560px;
    margin-inline: auto;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 26px;
  }
  /* 넓은 화면 4칸 · 태블릿 2칸 · 폰 1칸 */
  .features {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
  }
  .feature {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .feature-icon {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin-bottom: 14px;
    border: 1.5px dashed var(--stitch);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .feature h2 {
    margin: 0 0 4px;
    font-size: 21px;
  }
  .feature p {
    flex: 1;
    margin: 0 0 16px;
    color: var(--muted);
    font-size: 15.5px;
  }
  .split {
    display: grid;
    gap: 0 44px;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
  }
  @media (max-width: 760px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .recent {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 11px 0;
  }
  .recent a {
    min-width: 0;
    color: var(--ink);
    font-size: 17px;
  }
  .leader {
    flex: 1;
    min-width: 24px;
    border-bottom: 2px dotted var(--border);
  }
  .recent .meta {
    flex-shrink: 0;
  }
  .news {
    display: block;
    max-width: 380px;
  }
</style>
