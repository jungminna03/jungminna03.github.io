---
import '../styles/global.css';
import profile from '../../config/profile.mjs';
import { url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** 검색 엔진 색인 제외 */
  noindex?: boolean;
}

const { title, description = profile.intro, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.siteTitle}` : profile.siteTitle;

const nav = [
  { href: '/diary/', label: '기술 일기' },
  { href: '/portfolio/', label: '포트폴리오' },
  { href: '/jobs/', label: '채용 추천' },
  { href: '/cardnews/', label: '카드뉴스' },
];
const trim = (path: string) => path.replace(/\/+$/, '');
const isCurrent = (href: string) => trim(Astro.url.pathname).startsWith(trim(url(href)));
// 로고용 필기체: Brush Script MT 가 없는 기기(안드로이드 등)에서만 쓰이고, 로고 글자만 받아온다
const scriptFont = `https://fonts.googleapis.com/css2?family=Yellowtail&display=swap&text=${encodeURIComponent(`${profile.siteTitle}Crafted in`)}`;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f8f6e8" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={scriptFont} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url('/')}>{profile.siteTitle}</a>
        <nav class="site-nav" aria-label="주요 메뉴">
          {nav.map((item) => (
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span class="footer-mark">Crafted in {profile.siteTitle}</span>
        <span>
          © {new Date().getFullYear()} {profile.name}
          {profile.links.GitHub && <> · <a href={profile.links.GitHub}>GitHub</a></>}
        </span>
      </div>
    </footer>
  </body>
</html>
