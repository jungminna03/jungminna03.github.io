---
// 포트폴리오 — 기술 일기에서 자동으로 정리된 서류
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Sprite from '../Sprite.astro';
import profile from '../../../config/profile.mjs';
import { getDiary, toPortfolioEntry } from '../../lib/content';
import { buildPortfolio } from '../../lib/portfolio.mjs';
import { formatDate, url } from '../../lib/site';

const diary = await getDiary();
const portfolio = buildPortfolio(diary.map(toPortfolioEntry), profile.skills);
// 프로젝트 카드를 누르면 올라오는 종이에 넣을 본문 (프로젝트에 속한 일기만 렌더링)
const byId = new Map(diary.map((e) => [e.id, e]));
const coverOf = (entries: { id: string }[]) => [...entries].reverse().map((e) => byId.get(e.id)?.data.cover).find(Boolean);
const bodies = new Map(
  await Promise.all(diary.filter((e) => e.data.project).map(async (e) => [e.id, (await render(e)).Content] as const)),
);
const month = (date: Date) => formatDate(date).slice(0, 7);
const period = (from: Date, to: Date) => (month(from) === month(to) ? month(from) : `${month(from)} – ${month(to)}`);
const links = Object.entries(profile.links).filter(([, href]) => href);

// 기술 스택: 프로필에 적은 주력 기술을 그 순서대로 앞에, 나머지는 많이 쓴 순
const mainKeys = profile.skills.map((s) => s.toLowerCase());
const mainSkills = mainKeys.flatMap((key) => portfolio.skills.filter((s) => s.name.toLowerCase() === key));
const otherSkills = portfolio.skills.filter((s) => !mainKeys.includes(s.name.toLowerCase()));

---

<header class="paper-head">
  <Sprite name="folder" scale={3} />
  <div>
    <h2>포트폴리오</h2>
  </div>
  <button class="px-btn no-print" type="button" data-print>PDF로 저장</button>
</header>

<div class="profile-card">
  <div>
    <p class="profile-name">{profile.name}</p>
    {profile.headline && <p class="profile-headline">{profile.headline}</p>}
    <p class="profile-intro">{profile.intro}</p>
  </div>
  <dl class="facts">
    {
      profile.email && (
        <div>
          <dt>이메일</dt>
          <dd>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </dd>
        </div>
      )
    }
    {
      profile.phone && (
        <div>
          <dt>전화</dt>
          <dd>
            <a href={`tel:${profile.phone.replaceAll('-', '')}`}>{profile.phone}</a>
          </dd>
        </div>
      )
    }
    {
      profile.location && (
        <div>
          <dt>지역</dt>
          <dd>{profile.location}</dd>
        </div>
      )
    }
    {
      profile.languages.length > 0 && (
        <div>
          <dt>언어</dt>
          <dd>{profile.languages.map((l) => `${l.name} (${l.level})`).join(' · ')}</dd>
        </div>
      )
    }
    {
      profile.education.map((e) => (
        <div>
          <dt>학력</dt>
          <dd>{[e.school, e.major, e.period].filter(Boolean).join(' · ')}</dd>
        </div>
      ))
    }
    {
      links.map(([label, href]) => (
        <div>
          <dt>{label}</dt>
          <dd>
            <a href={href}>{href.replace(/^https?:\/\//, '')}</a>
          </dd>
        </div>
      ))
    }
  </dl>
</div>

{
  portfolio.skills.length > 0 && (
    <section>
      <h3 class="sec-title">기술 스택</h3>
      <ul class="chips">
        {mainSkills.map((skill) => (
          <li class="chip chip-strong">{skill.name}</li>
        ))}
        {otherSkills.map((skill) => (
          <li class="chip">{skill.name}</li>
        ))}
      </ul>
    </section>
  )
}

{
  portfolio.count === 0 ? (
    <div class="empty-note">
      <p class="empty-title">프로젝트가 아직 없어요</p>
      <p>
        기술 일기에 <code>project</code> · <code>period</code> · <code>skills</code> · <code>highlight</code> 를 적으면 여기에 프로젝트가 쌓여요.
      </p>
    </div>
  ) : (
    <>
      {portfolio.projects.length > 0 && (
        <section>
          <h3 class="sec-title">프로젝트</h3>
          <div class="project-grid">
            {portfolio.projects.map((project, i) => (
              <a class="project" href={url(`/diary/${project.entries[project.entries.length - 1].id}/`)} data-sheet={`project-${i}`}>
                {(() => {
                  const cover = coverOf(project.entries);
                  return cover ? (
                    <Image class="project-cover" src={cover} alt="" width={640} />
                  ) : (
                    <span class="project-cover project-cover-empty" aria-hidden="true">
                      <Sprite name="folder" scale={4} />
                    </span>
                  );
                })()}
                <h4>{project.name}</h4>
                <p class="meta">{project.period ?? period(project.from, project.to)}</p>
                {project.highlights[0] && <p class="project-highlight">{project.highlights[0].text}</p>}
                {project.skills.length > 0 && (
                  <ul class="chips">
                    {project.skills.map((skill) => (
                      <li class="chip">{skill}</li>
                    ))}
                  </ul>
                )}
                <span class="project-more no-print">자세히 보기 ▲</span>
              </a>
            ))}
          </div>
          {portfolio.projects.map((project, i) => (
            <template data-sheet-body={`project-${i}`}>
              <header class="post-head">
                <p class="meta">{project.period ?? period(project.from, project.to)}</p>
                <h1>{project.name}</h1>
                {project.skills.length > 0 && (
                  <ul class="chips">
                    {project.skills.map((skill) => (
                      <li class="chip chip-strong">{skill}</li>
                    ))}
                  </ul>
                )}
              </header>
              {project.highlights.map((h) => (
                <aside class="highlight">
                  <strong>핵심 성과</strong>
                  <p>{h.text}</p>
                </aside>
              ))}
              {[...project.entries].reverse().map((entry) => {
                const Body = bodies.get(entry.id);
                return (
                  <section class="sheet-entry">
                    {project.entries.length > 1 && <h2 class="sheet-entry-title">{entry.title}</h2>}
                    <div class="prose">{Body && <Body />}</div>
                    <p class="meta">
                      <a href={url(`/diary/${entry.id}/`)}>노트 페이지로 열기 →</a>
                    </p>
                  </section>
                );
              })}
            </template>
          ))}
        </section>
      )}
    </>
  )
}


<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());

</script>
