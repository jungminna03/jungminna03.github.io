---
// 기술 일기 — 줄 공책
import { render } from 'astro:content';
import Sprite from '../Sprite.astro';
import { getDiary } from '../../lib/content';
import { formatDate, url } from '../../lib/site';

const entries = await getDiary();
// 클릭하면 올라오는 종이에 넣을 본문
const bodies = new Map(await Promise.all(entries.map(async (e) => [e.id, (await render(e)).Content] as const)));
const years = new Map<string, typeof entries>();
for (const entry of entries) {
  const year = formatDate(entry.data.date).slice(0, 4);
  years.set(year, [...(years.get(year) ?? []), entry]);
}
---

<header class="paper-head">
  <Sprite name="quill" scale={3} />
  <div>
    <h2>기술 일기</h2>
  </div>
</header>

{
  entries.length === 0 ? (
    <div class="empty-note">
      <p class="empty-title">아직 첫 장이 비어 있어요</p>
      <p>
        <code>src/content/diary</code> 에 마크다운으로 첫 일기를 써 보세요.
      </p>
    </div>
  ) : (
    [...years].map(([year, list]) => (
      <section class="diary-year">
        <h3 class="sec-title">
          {year} <span class="count">{list.length}</span>
        </h3>
        <ol class="notebook">
          {list.map((entry) => (
            <li>
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date).slice(5)}</time>
              <div>
                <a class="entry-title" href={url(`/diary/${entry.id}/`)} data-sheet={`diary-${entry.id}`}>
                  {entry.data.title}
                </a>
                {entry.data.draft && <span class="stamp maybe">초안</span>}
                {entry.data.highlight && <p class="entry-highlight">★ {entry.data.highlight}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  )
}

{
  entries.map((entry) => {
    const Body = bodies.get(entry.id)!;
    const { title, date, period, highlight, skills } = entry.data;
    return (
      <template data-sheet-body={`diary-${entry.id}`}>
        <header class="post-head">
          <p class="meta">{period ?? formatDate(date)}</p>
          <h1>{title}</h1>
        </header>
        {highlight && (
          <aside class="highlight">
            <strong>핵심 성과</strong>
            <p>{highlight}</p>
          </aside>
        )}
        <div class="prose">
          <Body />
        </div>
        {skills.length > 0 && (
          <footer class="post-skills">
            <span class="meta">사용 기술</span>
            <ul class="chips">
              {skills.map((skill) => (
                <li class="chip chip-strong">{skill}</li>
              ))}
            </ul>
          </footer>
        )}
        <p class="meta">
          <a href={url(`/diary/${entry.id}/`)}>노트 페이지로 열기 →</a>
        </p>
      </template>
    );
  })
}
