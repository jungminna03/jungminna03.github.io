---
// 손그림 느낌의 선 아이콘 (stroke = currentColor)
interface Props {
  name: 'quill' | 'folder' | 'compass' | 'cards';
  size?: number;
}

const { name, size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'quill' && (
      <>
        <path d="M20 3.5c-7 .5-12 5.5-13.5 13l-2.5 4 4-2.5c7.5-1.5 12.5-6.5 12-14.5z" />
        <path d="M8.5 15.5 14 10" />
        <path d="M11 12.5h3.5" />
      </>
    )
  }
  {
    name === 'folder' && (
      <>
        <path d="M3.5 8.5h17v10.5a1.5 1.5 0 0 1-1.5 1.5H5a1.5 1.5 0 0 1-1.5-1.5z" />
        <path d="M8.5 8.5V6.2A1.7 1.7 0 0 1 10.2 4.5h3.6a1.7 1.7 0 0 1 1.7 1.7v2.3" />
        <path d="M3.5 13.5h17" stroke-dasharray="1.6 1.9" />
        <path d="M11 13.5v2h2v-2" />
      </>
    )
  }
  {
    name === 'compass' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="m15.5 8.5-2.2 4.8-4.8 2.2 2.2-4.8z" />
        <path d="M12 2.5v1.5M12 20v1.5M2.5 12H4M20 12h1.5" />
      </>
    )
  }
  {
    name === 'cards' && (
      <>
        <rect x="8" y="3.5" width="11.5" height="14.5" rx="1.8" />
        <path d="M5.5 6.5v12a2 2 0 0 0 2 2h9" />
        <path d="M11 8h5.5M11 11h5.5M11 14h3" />
      </>
    )
  }
</svg>
