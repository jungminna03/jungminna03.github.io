---
// 정사각형 카드 한 장. 글자 크기를 카드 너비(cqi) 기준으로 잡아서 썸네일·뷰어 어디서든 같은 구도로 보인다.
// 표지는 가죽 꼬리표, 본문은 크림 종이 — 둘 다 박음질 점선.
import { asset, formatDate } from '../lib/site';

interface Props {
  variant: 'cover' | 'content';
  accent: string;
  title: string;
  summary?: string;
  date?: Date;
  body?: string;
  image?: string;
  sources?: { label: string; url: string }[];
  /** 세트 안에서의 순서 (표지 = 1) */
  index?: number;
  total?: number;
}

const { variant, accent, title, summary, date, body, image, sources = [], index, total } = Astro.props;
const long = [...title].length > (variant === 'cover' ? 26 : 32);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class:list={['cn-card', `cn-${variant}`, { long }]} style={`--cn-accent: ${accent}`}>
  <div class="cn-inner">
    {
      variant === 'cover' ? (
        <>
          <span class="cn-label">✦ Game Trend ✦</span>
          <div>
            <h2 class="cn-title">{title}</h2>
            {summary && <p class="cn-summary">{summary}</p>}
          </div>
          <div class="cn-foot">
            <span>{date && formatDate(date)}</span>
            {total && <span>{pad(1)} / {pad(total)}</span>}
          </div>
        </>
      ) : (
        <>
          {index && <span class="cn-num">No. {pad(index)}</span>}
          {image && <img class="cn-image" src={asset(image)} alt="" loading="lazy" />}
          <h3 class="cn-title">{title}</h3>
          {body && <p class="cn-body">{body}</p>}
          <div class="cn-foot">
            <span class="cn-sources">
              {sources.map((source) => (
                <a href={source.url} target="_blank" rel="noopener">
                  {source.label}
                </a>
              ))}
            </span>
            {index && total && (
              <span>
                {pad(index)} / {pad(total)}
              </span>
            )}
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  .cn-card {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: var(--shadow);
    isolation: isolate;
  }
  /* 종이·가죽 결 */
  .cn-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--grain);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  /* 박음질 */
  .cn-card::after {
    content: '';
    position: absolute;
    inset: 3.2cqi;
    z-index: 1;
    border: 2px dashed rgb(255 253 245 / 0.55);
    border-radius: 12px;
    pointer-events: none;
  }
  .cn-inner {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 9cqi;
  }
  .cn-title {
    margin: 0;
    font-weight: 400;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cn-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3cqi;
    margin-top: auto;
    font-size: 3.4cqi;
    font-variant-numeric: tabular-nums;
  }

  /* 표지 — 가죽 꼬리표 */
  .cn-cover {
    color: #fffdf5;
    background:
      radial-gradient(110% 80% at 0% 0%, rgb(255 255 255 / 0.16) 0%, transparent 60%),
      linear-gradient(160deg, var(--cn-accent) 30%, color-mix(in srgb, var(--cn-accent) 72%, #000) 100%);
  }
  .cn-cover .cn-inner {
    justify-content: space-between;
  }
  .cn-label {
    font-size: 3.4cqi;
    letter-spacing: 0.2em;
    opacity: 0.85;
    text-transform: uppercase;
  }
  .cn-cover .cn-title {
    color: inherit;
    font-size: 9.6cqi;
    line-height: 1.22;
  }
  .cn-cover.long .cn-title {
    font-size: 7.6cqi;
  }
  .cn-summary {
    margin: 3.5cqi 0 0;
    font-size: 4.2cqi;
    line-height: 1.5;
    opacity: 0.9;
  }
  .cn-cover .cn-foot {
    margin-top: 0;
    opacity: 0.85;
  }

  /* 본문 카드 — 크림 종이 */
  .cn-content {
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--border),
      var(--shadow);
    color: var(--text);
  }
  .cn-content::after {
    border-color: color-mix(in srgb, var(--cn-accent) 45%, transparent);
  }
  .cn-num {
    color: var(--cn-accent);
    font-size: 4.2cqi;
    letter-spacing: 0.08em;
  }
  .cn-image {
    width: 100%;
    margin-top: 3cqi;
    aspect-ratio: 16 / 9;
    border-radius: 3cqi;
    object-fit: cover;
  }
  .cn-content .cn-title {
    margin: 2.5cqi 0 4cqi;
    color: var(--ink);
    font-size: 7.4cqi;
    line-height: 1.32;
  }
  .cn-content.long .cn-title {
    font-size: 5.8cqi;
  }
  .cn-body {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 4.4cqi;
    line-height: 1.65;
    white-space: pre-line;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
  }
  .cn-content .cn-foot {
    color: var(--faint);
  }
  .cn-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 1cqi 3cqi;
    min-width: 0;
  }
  .cn-sources a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
