---
// 정사각형 카드 한 장. 글자 크기를 카드 너비(cqi) 기준으로 잡아서 썸네일·뷰어 어디서든 같은 구도로 보인다.
import { asset, formatDate } from '../lib/site';

interface Props {
  variant: 'cover' | 'content';
  accent: string;
  title: string;
  summary?: string;
  date?: Date;
  body?: string;
  image?: string;
  sources?: { label: string; url: string }[];
  /** 세트 안에서의 순서 (표지 = 1) */
  index?: number;
  total?: number;
}

const { variant, accent, title, summary, date, body, image, sources = [], index, total } = Astro.props;
const long = [...title].length > (variant === 'cover' ? 26 : 32);
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class:list={['cn-card', `cn-${variant}`, { long }]} style={`--cn-accent: ${accent}`}>
  <div class="cn-inner">
    {
      variant === 'cover' ? (
        <>
          <span class="cn-label">GAME TREND</span>
          <div>
            <h2 class="cn-title">{title}</h2>
            {summary && <p class="cn-summary">{summary}</p>}
          </div>
          <div class="cn-foot">
            <span>{date && formatDate(date)}</span>
            {total && <span>{pad(1)} / {pad(total)}</span>}
          </div>
        </>
      ) : (
        <>
          {index && <span class="cn-num">{pad(index)}</span>}
          {image && <img class="cn-image" src={asset(image)} alt="" loading="lazy" />}
          <h3 class="cn-title">{title}</h3>
          {body && <p class="cn-body">{body}</p>}
          <div class="cn-foot">
            <span class="cn-sources">
              {sources.map((source) => (
                <a href={source.url} target="_blank" rel="noopener">
                  {source.label}
                </a>
              ))}
            </span>
            {index && total && (
              <span>
                {pad(index)} / {pad(total)}
              </span>
            )}
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  .cn-card {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 18px;
    isolation: isolate;
  }
  .cn-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 8cqi;
  }
  .cn-title {
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .cn-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3cqi;
    margin-top: auto;
    font-size: 3.3cqi;
    font-variant-numeric: tabular-nums;
  }

  /* 표지 */
  .cn-cover {
    color: #fff;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--cn-accent) 55%, #fff) 0%, transparent 55%),
      linear-gradient(155deg, var(--cn-accent) 0%, color-mix(in srgb, var(--cn-accent) 45%, #000) 100%);
  }
  .cn-cover .cn-inner {
    justify-content: space-between;
  }
  .cn-label {
    font-size: 3.3cqi;
    font-weight: 800;
    letter-spacing: 0.16em;
    opacity: 0.85;
  }
  .cn-cover .cn-title {
    font-size: 9.4cqi;
    line-height: 1.2;
  }
  .cn-cover.long .cn-title {
    font-size: 7.4cqi;
  }
  .cn-summary {
    margin: 3cqi 0 0;
    font-size: 4.1cqi;
    line-height: 1.5;
    opacity: 0.92;
  }
  .cn-cover .cn-foot {
    margin-top: 0;
    opacity: 0.85;
  }

  /* 본문 카드 */
  .cn-content {
    background: color-mix(in srgb, var(--cn-accent) 8%, var(--bg));
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--text);
  }
  .cn-num {
    color: var(--cn-accent);
    font-size: 4.6cqi;
    font-weight: 800;
  }
  .cn-image {
    width: 100%;
    margin-top: 3cqi;
    aspect-ratio: 16 / 9;
    border-radius: 3cqi;
    object-fit: cover;
  }
  .cn-content .cn-title {
    margin: 2.5cqi 0 4cqi;
    font-size: 7.2cqi;
    line-height: 1.3;
  }
  .cn-content.long .cn-title {
    font-size: 5.6cqi;
  }
  .cn-body {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: color-mix(in srgb, var(--text) 84%, transparent);
    font-size: 4.3cqi;
    line-height: 1.62;
    white-space: pre-line;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
  }
  .cn-content .cn-foot {
    color: var(--muted);
  }
  .cn-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 1cqi 3cqi;
    min-width: 0;
  }
  .cn-sources a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
