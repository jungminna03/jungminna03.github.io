---
// 카드뉴스 뷰어: 스와이프(스크롤 스냅) · 이전/다음 버튼 · 키보드 ←/→ · 점 네비게이션
import type { CollectionEntry } from 'astro:content';
import CardNewsCard from './CardNewsCard.astro';

interface Props {
  entry: CollectionEntry<'cardnews'>;
}

const { title, summary, date, accent, cards } = Astro.props.entry.data;
const total = cards.length + 1;
---

<section class="viewer" data-viewer aria-roledescription="carousel" aria-label={title}>
  <div class="track" data-track tabindex="0">
    <div class="slide" aria-roledescription="slide" aria-label={`1 / ${total}`}>
      <CardNewsCard variant="cover" accent={accent} title={title} summary={summary} date={date} total={total} />
    </div>
    {
      cards.map((card, i) => (
        <div class="slide" aria-roledescription="slide" aria-label={`${i + 2} / ${total}`}>
          <CardNewsCard variant="content" accent={accent} {...card} index={i + 2} total={total} />
        </div>
      ))
    }
  </div>
  <div class="controls">
    <button type="button" data-prev aria-label="이전 카드">←</button>
    <span class="counter"><b data-current>1</b> / {total}</span>
    <button type="button" data-next aria-label="다음 카드">→</button>
  </div>
  <div class="dots">
    {Array.from({ length: total }, (_, i) => <button type="button" data-dot aria-label={`${i + 1}번 카드`} />)}
  </div>
</section>

<script>
  for (const viewer of document.querySelectorAll<HTMLElement>('[data-viewer]')) {
    const track = viewer.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const current = viewer.querySelector<HTMLElement>('[data-current]')!;
    const prev = viewer.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = viewer.querySelector<HTMLButtonElement>('[data-next]')!;
    const dots = Array.from(viewer.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    let index = 0;

    const go = (i: number) => {
      const target = slides[Math.max(0, Math.min(i, slides.length - 1))];
      track.scrollTo({ left: target.offsetLeft - slides[0].offsetLeft, behavior: 'smooth' });
    };
    const show = (i: number) => {
      index = i;
      current.textContent = String(i + 1);
      prev.disabled = i === 0;
      next.disabled = i === slides.length - 1;
      dots.forEach((dot, j) => dot.setAttribute('aria-current', String(i === j)));
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) if (entry.isIntersecting) show(slides.indexOf(entry.target as HTMLElement));
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((slide) => observer.observe(slide));
    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, j) => dot.addEventListener('click', () => go(j)));
    document.addEventListener('keydown', (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
      if (event.key === 'ArrowLeft') go(index - 1);
      if (event.key === 'ArrowRight') go(index + 1);
    });
    show(0);
  }
</script>

<style>
  .viewer {
    max-width: 540px;
    margin: 0 auto;
  }
  .track {
    position: relative;
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 18px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 16px;
  }
  .controls button {
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    font-size: 18px;
    cursor: pointer;
  }
  .controls button:disabled {
    cursor: default;
    opacity: 0.35;
  }
  .counter {
    min-width: 64px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .counter b {
    color: var(--text);
  }
  .dots {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
  }
  .dots button {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: var(--border);
    cursor: pointer;
    transition: width 0.2s;
  }
  .dots button[aria-current='true'] {
    width: 22px;
    background: var(--accent);
  }
</style>
